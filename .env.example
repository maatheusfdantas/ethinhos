# ============================================================================
# ETHOS - TEMPLATE DE VARIÁVEIS DE AMBIENTE DE SEGURANÇA (.env.example)
# ============================================================================
# Copie este arquivo para `.env` em desenvolvimento ou injete via Secret Manager / KMS em produção.
# NUNCA faça commit do arquivo `.env` real no Git.

PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Chaves Criptográficas (Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ETHOS_MASTER_KEY=substitua_por_chave_kms_256_bits_hexadecimal_em_producao
ETHOS_JWT_SECRET=substitua_por_segredo_jwt_hmac_sha256_forte_em_producao

# Credenciais OAuth 2.0 do Google Calendar (Google Cloud Console)
GOOGLE_CLIENT_ID=SEU_GOOGLE_CLIENT_ID_AQUI.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=SEU_GOOGLE_CLIENT_SECRET_AQUI
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/oauth/callback/google

# Credenciais OAuth 2.0 do Microsoft Graph / Outlook (Azure Portal > Entra ID)
MICROSOFT_CLIENT_ID=SEU_MICROSOFT_CLIENT_ID_AQUI
MICROSOFT_CLIENT_SECRET=SEU_MICROSOFT_CLIENT_SECRET_AQUI
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/auth/oauth/callback/microsoft

FRONTEND_URL=http://localhost:5173

# Resend API de envio de emails transacionais
RESEND_API_KEY=re_sua_chave_resend_aqui
RESEND_FROM=Ethos <onboarding@resend.dev>
