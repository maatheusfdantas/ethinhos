{
  "name": "ethos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "cf:login": "npx wrangler login",
    "cf:db:create": "npx wrangler d1 create ethos-db",
    "cf:db:migrate:local": "npx wrangler d1 migrations apply ethos-db --local",
    "cf:db:migrations:list": "npx wrangler d1 migrations list ethos-db --local",
    "cf:deploy": "npm run build && npx wrangler pages deploy dist --project-name=ethos",
    "typecheck": "tsc --noEmit",
    "guard": "node scripts/agent-guard.mjs --range origin/main",
    "guard:staged": "node scripts/agent-guard.mjs --staged",
    "scope:init": "node scripts/agent-scope.mjs init",
    "scope:add": "node scripts/agent-scope.mjs add",
    "scope:allow-delete": "node scripts/agent-scope.mjs allow-delete",
    "scope:allow-large-removal": "node scripts/agent-scope.mjs allow-large-removal",
    "scope:show": "node scripts/agent-scope.mjs show",
    "agent:start": "node scripts/agent-start.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "framer-motion": "^14.12.0",
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.37.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^31.0.0",
    "oxlint": "^1.81.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
