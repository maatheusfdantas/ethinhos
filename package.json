{
  "name": "ethos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cf:login": "npx wrangler login",
    "cf:db:create": "npx wrangler d1 create ethos-db",
    "cf:db:migrate": "npx wrangler d1 execute ethos-db --remote --file=./cloudflare/d1_schema.sql",
    "cf:deploy": "npm run build && npx wrangler pages deploy dist --project-name=ethos"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.37.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
